# 构建产物
/target/

# 运行时数据(默认在用户数据目录,但开发时可能落到这里)
/data/
/testdata/
/.testdata/
/.e2e/

# 工程目录。正常情况下它在数据目录里,但 --data-dir 指到仓库时会出现
/projects/

# 中间文件与探针
/.build-probe/
*.log

# Tauri 构建时自动生成的 schema。
#
# `src-tauri/build.rs` 里只有 `tauri_build::build()`,这四个文件每次构建
# 都会重新生成。提交它们只会让每次编译都产生无意义的 diff。
/src-tauri/gen/

# 桌面快捷方式脚本生成的产物(如果有)
*.lnk

# 第三方前端库是下载来的,可从 ui/vendor/README.txt 的步骤重新获取
/ui/vendor/*
!/ui/vendor/README.txt

# 模型与二进制是资产,不入库(体积大且可从 README 的步骤重建)
#
# 用「排除目录下的一切、再放行小文本文件」的写法,而不是逐个扩展名列举。
# 原因:漏一个扩展名就会把 GB 级文件放进仓库 —— 实测加 CrispASR 时
# `models/firered/*.gguf`(919 MB)和 `binaries/crispasr/*.zip`(136 MB)
# 都没被旧规则覆盖。**默认排除、白名单放行**更安全。
/models/**
!/models/.gitkeep
!/models/README.md

/binaries/**
!/binaries/.gitkeep
!/binaries/README.md

# 例外:原生库要保留(体积小且国内下载困难,见 native/sherpa-rs/README.txt)
!/native/sherpa-rs/**

# 编辑器与系统
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini
