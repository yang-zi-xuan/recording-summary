{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "主窗口的权限集。按实际用到的命令显式列出 —— 不依赖各插件的 default 集合,因为实测 opener:default 是空集,授权与否看不出来。",
  "windows": ["main"],
  "permissions": [
    "core:default",

    "core:webview:allow-internal-toggle-devtools",

    "dialog:allow-open",
    "dialog:allow-save",

    "opener:allow-open-path",
    "opener:allow-reveal-item-in-dir"
  ]
}
